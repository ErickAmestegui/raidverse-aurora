# Register a confidential Twitch application; enter credentials ONLY in local .env.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
APP_ORIGIN=http://localhost:3000
PORT=3000
HOST=127.0.0.1
# Use a private directory with restricted access for the database and vault key.
DATA_DIR=./data
# Required only for remote hosting, behind HTTPS and a reverse proxy.
SECURE_COOKIES=false
# Disable synthetic operator sessions when hosting for real streamers.
ENABLE_REHEARSAL=true
